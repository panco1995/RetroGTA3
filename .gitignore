# ============================================================
# RetroGTA3 — .gitignore
# 原则：源码入库，产物不入库。
# 所有"可由代码确定性重建"的东西都不进 git，
# 避免每次调生成器都产生几十个二进制文件的不可读 diff。
# ============================================================

# ---- 依赖 ----
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- 构建产物 ----
dist/
dist-ssr/
build/
*.local

# ---- Vite 缓存 ----
.vite/
node_modules/.vite/

# ---- 烘焙角色素材（入库）----
# assets-src/baked/*.png 是 CC0 低模烘焙出来的「美术资产」，
# 跟 CC0 模型本身同级：重新生成要 Playwright + 浏览器，
# 不能只靠 `npm run gen`（纯 Node）重建，所以要入库。
# 但换色用的中间贴图（textures/）是纯中间产物，不入库。
assets-src/baked/textures/

# ---- 程序化生成的素材 ----
# 由 `npm run gen` 确定性重建（mulberry32 seed），不入库。
# dev/build 前会自动执行 predev / prebuild，不需要手动生成。
public/assets/proc/

# ---- 截图自检产物 ----
# README 用的画面在 screenshots/，要入库。这里只忽略自动截出来的。
.shots/
shot-output/

# ---- 素材放大核对图（纯人工审查用，`make gen-zoom` 随时重建）----
docs/preview-tiles.png
docs/preview-props.png

# ---- Playwright ----
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright/

# ---- 测试覆盖率 ----
coverage/
.nyc_output/

# ---- 环境变量 ----
.env
.env.*
!.env.example

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.code-workspace

# ---- 系统文件 ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---- 日志 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Tauri（后期桌面版打包）----
src-tauri/target/
src-tauri/gen/

# ---- 临时目录 ----
tmp/
.cache/
.temp/
.vscode